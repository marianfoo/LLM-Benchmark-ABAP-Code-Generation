# Copy this file to .env and fill in your credentials.

# SAP ADT connection (remote system for ABAP testing)
SAP_HOST=
SAP_USERNAME=
SAP_PASSWORD=

# OpenAI-compatible providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# SAP AI Core (required for ABAP-1 via orchestration)
AICORE_AUTH_URL=
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=

# Optional overrides for ABAP-1 model routing
AICORE_MODEL_NAME=sap-abap-1
AICORE_MODEL_VERSION=latest
